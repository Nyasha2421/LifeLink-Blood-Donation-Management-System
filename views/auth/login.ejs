<%- include("../partials/head") %>
<%- include("../partials/navbar") %>
<main class="min-h-[80vh] flex items-center justify-center px-4">
<!-- Only the card – no head, navbar, footer, or body tag -->
<div class="w-full max-w-sm mx-auto my-12 md:my-16 bg-white rounded-2xl shadow-xl border border-gray-200 p-10">
  
  <!-- 🔐 Icon -->
  <div class="flex justify-center text-5xl text-rose-600 mb-2">
    <i class="fa-solid fa-right-to-bracket"></i>
  </div>

  <!-- Login to LifeLink -->
  <h1 class="text-2xl font-bold text-center text-gray-800">Login to LifeLink</h1>
  <p class="text-center text-gray-500 text-sm mt-1">Welcome back! Sign in to your LifeLink account</p>
  

  <!-- Form -->
  <form action="/login" method="POST" class="mt-6 space-y-4">
    
    <!-- Name -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">
        <i class="fa-regular fa-user mr-2 text-rose-500"></i> Name
      </label>
      <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
          <i class="fa-regular fa-user"></i>
        </span>
        <input type="text" name="name" placeholder="Enter Your Name" 
               class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-rose-400 focus:border-rose-400 outline-none">
      </div>
    </div>
<!-- Email -->
<div>
      <label class="block text-sm font-medium text-gray-700 mb-1">
        <i class="fa-regular fa-envelope mr-2 text-rose-500"></i> Email
      </label>
      <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
          <i class="fa-regular fa-envelope"></i>
        </span>
        <input type="email" name="email" placeholder="you@example.com" 
               class="w-full pl-10 pr-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-rose-400 focus:border-rose-400 outline-none">
      </div>
    </div>

    <!-- Password -->
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">
        <i class="fa-solid fa-lock mr-2 text-rose-500"></i> Password
      </label>
      <div class="relative">
        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 cursor-pointer">
          <!-- <i class="fa-solid fa-lock"></i> -->
           <i class="fa-regular fa-eye"></i>
        </span>
        <input type="password" name="password" placeholder="Enter your password" 
               class="w-full pl-10 pr-10 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-rose-400 focus:border-rose-400 outline-none">
              
      </div>
    </div>

    <!-- Remember & Forgot -->
    <div class="flex items-center justify-between text-sm">
      <label class="flex items-center gap-2 text-gray-600 cursor-pointer">
        <input type="checkbox" class="w-4 h-4 text-rose-600 border-gray-300 rounded focus:ring-rose-500">
        <span>Remember me</span>
      </label>
      <a href="#" class="text-gray-500 hover:text-rose-600 hover:underline underline-offset-2">Forgot Password?</a>
    </div>

    <!-- Login Button -->
    <button type="submit" 
            class="w-full py-3 bg-gradient-to-r from-rose-600 to-rose-700 hover:from-rose-700 hover:to-rose-800 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all flex items-center justify-center gap-2">
      <i class="fa-solid fa-arrow-right-to-bracket"></i> Login
    </button>
  </form>

  <!-- Register -->
  <div class="mt-6 text-center text-sm text-gray-600 border-t border-gray-100 pt-5">
    Don't have an account?
    <a href="/register" class="font-medium text-rose-600 hover:text-rose-700 underline-offset-2 hover:underline">Register Now</a>
  </div>
</div>
</main>
<%- include("../partials/footer") %>