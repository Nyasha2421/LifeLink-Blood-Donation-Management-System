<%- include("../partials/head") %>
  <%- include("../partials/navbar") %>


    <!-- ========== MAIN CONTENT WITH PROPER SPACING ========== -->
    <!-- The key fix: mt-6 or pt-6 creates gap between navbar and form -->
    <main class="max-w-4xl mx-auto px-4 py-6 md:py-10">

      <!-- Page Title -->
      <div class="mb-6">
        <h1 class="text-2xl md:text-3xl font-bold text-gray-800">Become a Blood Donor</h1>
        <p class="text-sm text-gray-500 flex items-center gap-1">
          <span class="inline-block w-2 h-2 bg-rose-400 rounded-full"></span> Your gift can save lives
        </p>
      </div>

      <!-- ========== FORM CARD ========== -->
      <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6 md:p-8">
        <form class="space-y-5" action="/become-donor" method="POST">
          <!-- Error Message -->
          <% if(errorMessage){ %>
            <div class="bg-red-100 text-red-700 p-3 rounded-xl mb-4">
              <%= errorMessage %>
            </div>
            <% } %>
              <!-- Row: Full Name + Age -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                    Full Name <span class="text-rose-600">*</span>
                  </label>
                  <input type="text" value="<%= formData?.fullname || '' %>" placeholder="e.g. Aman Sharma"
                    name="fullname" required
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-800 placeholder-gray-400 focus:border-rose-500 focus:ring-2 focus:ring-rose-200 outline-none transition" />
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                    Age <span class="text-rose-600">*</span>
                  </label>
                  <input type="number" value="<%= formData?.age || '' %>" placeholder="e.g. 28" min="18" max="75"
                    name="age" required
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-800 placeholder-gray-400 focus:border-rose-500 focus:ring-2 focus:ring-rose-200 outline-none transition" />
                </div>
              </div>

              <!-- Row: Gender + Blood Group + Availbilty -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                    Gender <span class="text-rose-600">*</span>
                  </label>
                  <select
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-800 bg-white focus:border-rose-500 focus:ring-2 focus:ring-rose-200 outline-none transition appearance-none"
                    name="gender">
                    <option value="" disabled <%=!formData?.gender ? "selected" : "" %>>
                      – Select –
                    </option>

                    <option value="Male" <%=formData?.gender==="Male" ? "selected" : "" %>>
                      Male
                    </option>

                    <option value="Female" <%=formData?.gender==="Female" ? "selected" : "" %>>
                      Female
                    </option>

                    <option value="Other" <%=formData?.gender==="Other" ? "selected" : "" %>>
                      Other
                    </option>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                    Available <span class="text-rose-600">*</span>
                  </label>
                  <select
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-800 bg-white focus:border-rose-500 focus:ring-2 focus:ring-rose-200 outline-none transition appearance-none"
                    name="available">
                    <option value="" disabled selected>– Select –</option>
                    <option value="true">Available</option>
                    <option value="false">Not Available</option>
                  </select>
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                    Blood Group <span class="text-rose-600">*</span>
                  </label>
                  <select
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-800 bg-white focus:border-rose-500 focus:ring-2 focus:ring-rose-200 outline-none transition appearance-none"
                    name="bloodgroup">
                    <option value="" disabled <%=!formData?.bloodgorup ? "selected" : "" %>>
                      – Select –
                    </option>
                    <option value="A+" <%=formData?.gender==="A+" ? "selected" : "" %>>A+</option>
                    <option value="A-" <%=formData?.gender==="A-" ? "selected" : "" %>>A-</option>
                    <option value="B+" <%=formData?.gender==="B+" ? "selected" : "" %>>B+</option>
                    <option value="B-" <%=formData?.gender==="B-" ? "selected" : "" %>>B-</option>
                    <option value="AB+" <%=formData?.gender==="AB+" ? "selected" : "" %>>AB+</option>
                    <option value="AB-" <%=formData?.gender==="AB-" ? "selected" : "" %>>AB-</option>
                    <option value="O+" <%=formData?.gender==="O+" ? "selected" : "" %>>O+</option>
                    <option value="O-" <%=formData?.gender==="O-" ? "selected" : "" %>>O-</option>
                  </select>
                </div>
              </div>

              <!-- Mobile Number -->
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                  Mobile Number <span class="text-rose-600">*</span>
                </label>
                <input type="tel" value="<%= formData?.mobilenumber || '' %>" placeholder="+91 98765 43210"
                  name="mobilenumber" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-800 placeholder-gray-400 focus:border-rose-500 focus:ring-2 focus:ring-rose-200 outline-none transition" />
              </div>

              <!-- City -->
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                  City <span class="text-rose-600">*</span>
                </label>
                <input type="text" value="<%= formData?.city || '' %>" placeholder="e.g. Mumbai" name="city" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-800 placeholder-gray-400 focus:border-rose-500 focus:ring-2 focus:ring-rose-200 outline-none transition" />
              </div>

              <!-- Address -->
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                  Address <span class="text-rose-600">*</span>
                </label>
                <input type="text" value="<%= formData?.address || '' %>" placeholder="Street, locality, landmark"
                  name="address" required
                  class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-800 placeholder-gray-400 focus:border-rose-500 focus:ring-2 focus:ring-rose-200 outline-none transition" />
              </div>

              <!-- Last Donation Date -->
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1.5">
                  Last Donation Date <span class="text-gray-400 text-xs font-normal ml-1">(if any)</span>
                </label>
                <input type="date" value="<%= formData?.lastDonationDate || '' %>" name="lastDonationDate"
                  class="w-full px-4 py-3 border border-gray-300 rounded-xl text-gray-800 focus:border-rose-500 focus:ring-2 focus:ring-rose-200 outline-none transition" />
                <p class="text-xs text-gray-400 mt-1.5">Leave blank if never donated</p>
              </div>

              <!-- Register Button -->
              <div class="pt-2">
                <button type="submit"
                  class="w-full bg-gradient-to-r from-rose-600 to-rose-700 hover:from-rose-700 hover:to-rose-800 text-white font-bold py-3.5 rounded-xl text-lg shadow-lg shadow-rose-200/50 transition hover:scale-[1.01] active:scale-[0.98]">
                  Register Now →
                </button>
              </div>

        </form>
      </div>

      <!-- Footer note -->
      <p class="text-center text-xs text-gray-400 mt-6">
        <span class="inline-block w-1.5 h-1.5 bg-rose-300 rounded-full mr-1"></span> Your information is safe with us
      </p>
    </main>



    <%- include("../partials/footer") %>