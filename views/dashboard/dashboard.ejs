<%- include("../partials/head") %>
    <%- include("../partials/navbar") %>

        <% if(donor) { %>
            <!-- ===== DONOR DASHBOARD ===== -->
            <div class="max-w-4xl mx-auto p-4 space-y-6">

                <!-- Welcome Card -->
                <div
                    class="bg-gradient-to-r from-rose-50 to-rose-100 rounded-xl shadow-md p-6 flex items-center justify-between">
                    <div>
                        <p class="text-sm text-rose-700 font-medium">Welcome back,</p>
                        <h2 class="text-2xl font-bold text-gray-800">
                            <%= donor.fullname %> <i class="fa-solid fa-hand text-orange-500"></i>
                        </h2>
                        <p class="text-gray-600">Manage your blood donation profile and requests.</p>
                    </div>
                </div>

                <!-- Blood Group & Status (2‑column grid) -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Blood Group Card -->
                    <div
                        class="bg-white rounded-xl shadow-md p-3 flex items-center space-x-4 border-l-8 border-rose-500">
                        <div class="text-4xl text-rose-500"><i class="fa-solid fa-droplet"></i></div>
                        <div>
                            <p class="text-sm text-gray-500 uppercase tracking-wider">Blood Group</p>
                            <p class="text-3xl font-bold text-rose-700">
                                <%= donor.bloodgroup %>
                            </p>
                        </div>
                    </div>

                    <!-- Availability Status Card -->
                    <div class="bg-white rounded-xl shadow-md p-3 flex items-center space-x-4">
                        <div class="text-4xl"><i class="fa-solid fa-heart text-rose-600"></i></div>
                        <div>
                            <p class="text-sm text-gray-500 uppercase tracking-wider">Donation Status</p>
                            <p class="text-xl font-semibold text-gray-800 flex items-center">
                                <span class="inline-block w-3 h-3 rounded-full mr-2 
                        <%= donor.available ? 'bg-green-500 animate-pulse' : 'bg-gray-400' %>">
                                </span>
                                <%= donor.available ? 'Available' : 'Not Available' %>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Donor Profile Card -->
                <div class="bg-white rounded-xl shadow-md p-6">
                    <h3 class="text-lg font-semibold text-gray-700 border-b pb-2 mb-4 flex items-center">
                        <i class="fa-solid fa-user text-rose-500 mr-2"></i>
                        <%= donor.fullname %> Donor Profile
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <span class="font-medium text-gray-500">Full Name</span><br>
                            <span class="text-gray-800">
                                <%= donor.fullname %>
                            </span>
                        </div>
                        <div>
                            <span class="font-medium text-gray-500">Age</span><br>
                            <span class="text-gray-800">
                                <%= donor.age %>
                            </span>
                        </div>
                        <div>
                            <span class="font-medium text-gray-500">Gender</span><br>
                            <span class="text-gray-800">
                                <%= donor.gender %>
                            </span>
                        </div>
                        <div>
                            <span class="font-medium text-gray-500">Blood Group</span><br>
                            <span class="text-gray-800 font-semibold text-rose-600">
                                <%= donor.bloodgroup %>
                            </span>
                        </div>
                        <div>
                            <span class="font-medium text-gray-500">Mobile</span><br>
                            <span class="text-gray-800">
                                <%= donor.mobilenumber %>
                            </span>
                        </div>
                        <div>
                            <span class="font-medium text-gray-500">City</span><br>
                            <span class="text-gray-800">
                                <%= donor.city %>
                            </span>
                        </div>
                        <div class="sm:col-span-2">
                            <span class="font-medium text-gray-500">Address</span><br>
                            <span class="text-gray-800">
                                <%= donor.address %>
                            </span>
                        </div>
                        <div>
                            <span class="font-medium text-gray-500">Last Donation</span><br>
                            <span class="text-gray-800">
                                <%= donor.lastDonationDate.toLocaleDateString("en-IN") %>
                            </span>
                        </div>
                        <div>
                            <span class="font-medium text-gray-500">Status</span><br>
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium 
                    <%= donor.available ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-600' %>">
                                <i class="fa-solid fa-circle text-xs mr-2"></i>
                                <%= donor.available ? ' Available' : ' Not Available' %>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="flex flex-wrap gap-4 justify-center md:justify-start">
                    <a href="/donor/edit"
                        class="bg-rose-600 hover:bg-rose-700 text-white px-6 py-2 rounded-full shadow-md hover:shadow-lg transition flex items-center gap-2">
                        Edit Profile
                    </a>
                    <a href="/requests/my"
                        class="border-2 border-rose-600 text-rose-600 hover:bg-rose-600 hover:text-white px-6 py-2 rounded-full shadow-md hover:shadow-lg transition flex items-center gap-2">
                        View Blood Requests
                    </a>
                    <a href="/logout"
                        class="bg-gray-200 hover:bg-gray-300 text-gray-700 px-6 py-2 rounded-full shadow-md hover:shadow-lg transition flex items-center gap-2">
                        Logout
                    </a>
                </div>
            </div>
            <!-- ===== END DASHBOARD ===== -->

            <% } else { %>
                <div class="max-w-4xl mx-auto p-4">

                    <div class="bg-white rounded-2xl shadow-md p-8 md:p-12 text-center border border-rose-100">

                        <!-- Icon -->
                        <div class="w-20 h-20 mx-auto mb-5 rounded-full bg-rose-100 flex items-center justify-center">
                            <i class="fa-solid fa-heart text-4xl text-rose-600"></i>
                        </div>

                        <!-- Heading -->
                        <h2 class="text-2xl md:text-3xl font-bold text-gray-800">
                            You’re Not a Donor Yet
                        </h2>

                        <!-- Message -->
                        <p class="text-gray-600 mt-3 max-w-lg mx-auto leading-relaxed">
                            You haven’t created your donor profile yet. Join LifeLink as a blood donor and help save
                            lives when someone needs blood.
                        </p>

                        <!-- Button -->
                        <a href="/become-donor"
                            class="inline-flex items-center gap-2 mt-6 bg-rose-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-rose-700 transition shadow-md hover:shadow-lg">

                            <i class="fa-solid fa-droplet"></i>
                            Become a Donor
                        </a>

                    </div>

                </div>
                <% } %>


                    <%- include("../partials/footer") %>