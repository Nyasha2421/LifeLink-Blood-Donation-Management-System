<%- include("../partials/head") %>
    <%- include("../partials/navbar") %>

        <div class="max-w-3xl mx-auto p-4 py-8">

            <div class="bg-white rounded-2xl shadow-md p-6 md:p-8">

                <!-- Heading -->
                <div class="text-center mb-7">
                    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-rose-100 flex items-center justify-center">
                        <i class="fa-solid fa-user-pen text-2xl text-rose-600"></i>
                    </div>

                    <h1 class="text-2xl font-bold text-gray-800">
                        Edit Donor Profile
                    </h1>

                    <p class="text-gray-500 mt-2">
                        Update your donor information below.
                    </p>
                </div>

                <% if(errorMessage) {%>
                    <div class="bg-red-100 text-red-700 p-3 rounded-lg mb-4">
                        <%= errorMessage %>
                    </div>
                    <% } %>

                        <!-- Edit Form -->
                        <form action="/donor/edit" method="POST" class="space-y-5">

                            <!-- Full Name -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    Full Name
                                </label>

                                <input type="text" name="fullname" value="<%= donor.fullname %>" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5
                    focus:outline-none focus:ring-2 focus:ring-rose-500">
                            </div>

                            <!-- Age and Gender -->
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">
                                        Age
                                    </label>

                                    <input type="number" name="age" value="<%= donor.age %>" min="18" max="75" required
                                        class="w-full border border-gray-300 rounded-lg px-4 py-2.5
                        focus:outline-none focus:ring-2 focus:ring-rose-500">
                                </div>

                                <div>
                                    <label class="block text-sm font-medium text-gray-700 mb-1">
                                        Gender
                                    </label>

                                    <select name="gender" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5
                        focus:outline-none focus:ring-2 focus:ring-rose-500">
                                        <option value="Male" <%=donor.gender==="Male" ? "selected" : "" %>>
                                            Male
                                        </option>

                                        <option value="Female" <%=donor.gender==="Female" ? "selected" : "" %>>
                                            Female
                                        </option>

                                        <option value="Other" <%=donor.gender==="Other" ? "selected" : "" %>>
                                            Other
                                        </option>
                                    </select>
                                </div>

                            </div>

                            <!-- Blood Group -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    Blood Group
                                </label>

                                <select name="bloodgroup" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5
                    focus:outline-none focus:ring-2 focus:ring-rose-500">

                                    <% const bloodGroups=[ "A+" , "A-" , "B+" , "B-" , "AB+" , "AB-" , "O+" , "O-" ]; %>

                                        <% bloodGroups.forEach(group=> { %>

                                            <option value="<%= group %>" <%=donor.bloodgroup===group ? "selected" : ""
                                                %>
                                                >
                                                <%= group %>
                                            </option>

                                            <% }) %>

                                </select>
                            </div>

                            <!-- Mobile Number -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    Mobile Number
                                </label>

                                <input type="tel" name="mobilenumber" value="<%= donor.mobilenumber %>" required
                                    maxlength="10" class="w-full border border-gray-300 rounded-lg px-4 py-2.5
                    focus:outline-none focus:ring-2 focus:ring-rose-500">
                            </div>

                            <!-- City -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    City
                                </label>

                                <input type="text" name="city" value="<%= donor.city %>" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5
                    focus:outline-none focus:ring-2 focus:ring-rose-500">
                            </div>

                            <!-- Address -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    Address
                                </label>

                                <textarea name="address" rows="3" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5
                    focus:outline-none focus:ring-2 focus:ring-rose-500"><%= donor.address %></textarea>
                            </div>

                            <!-- Last Donation Date -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                    Last Donation Date
                                </label>

                                <input type="date" name="lastDonationDate"
                                    value="<%= donor.lastDonationDate ? new Date(donor.lastDonationDate).toISOString().split('T')[0] : '' %>"
                                    required class="w-full border border-gray-300 rounded-lg px-4 py-2.5
                    focus:outline-none focus:ring-2 focus:ring-rose-500">
                            </div>

                            <!-- Availability -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700 mb-2">
                                    Donation Availability
                                </label>

                                <select name="available" class="w-full border border-gray-300 rounded-lg px-4 py-2.5
                    focus:outline-none focus:ring-2 focus:ring-rose-500">
                                    <option value="true" <%=donor.available ? "selected" : "" %>
                                        >
                                        Available
                                    </option>

                                    <option value="false" <%=!donor.available ? "selected" : "" %>
                                        >
                                        Not Available
                                    </option>
                                </select>
                            </div>

                            <!-- Buttons -->
                            <div class="flex flex-col sm:flex-row gap-4 pt-3">

                                <button type="submit" class="flex-1 bg-rose-600 text-white py-3 rounded-lg
                    font-semibold hover:bg-rose-700 transition">
                                    <i class="fa-solid fa-floppy-disk mr-2"></i>
                                    Save Changes
                                </button>

                                <a href="/dashboard" class="flex-1 text-center bg-gray-200 text-gray-700 py-3
                    rounded-lg font-semibold hover:bg-gray-300 transition">
                                    Cancel
                                </a>

                            </div>

                        </form>

            </div>

        </div>

        <%- include("../partials/footer") %>