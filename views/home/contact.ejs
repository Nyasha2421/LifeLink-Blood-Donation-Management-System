<%- include("../partials/head") %>
    <%- include("../partials/navbar") %>

        <div class="min-h-screen flex items-center justify-center bg-[#f8f5f2] p-4 md:p-6 font-sans">

            <!-- Main card – same style as Login/Register -->
            <div
                class="w-full max-w-[840px] bg-white rounded-3xl shadow-xl shadow-gray-200/50 hover:shadow-2xl transition-shadow duration-300 p-6 sm:p-8 md:p-10">

                <!-- Header -->
                <div class="text-center mb-8">
                    <h1 class="text-2xl md:text-3xl font-bold text-gray-800 flex items-center justify-center gap-3">
                        <i class="fas fa-paper-plane text-rose-600 text-2xl"></i>
                        Contact Us
                    </h1>
                    <p class="text-gray-500 text-sm mt-1">We’d love to hear from you — drop us a message</p>
                </div>
                <% if(errorMessage) { %>
                    <div class="bg-red-100 text-red-700 p-3 rounded-lg mb-4">
                     <%= errorMessage %>
                    </div>
              <%  } %>

                <!-- Form -->
                <form action="/contact" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <!-- Full Name -->
                    <div class="flex flex-col gap-1">
                        <label class="text-sm font-semibold text-gray-800 flex items-center gap-2">
                            <i class="fas fa-user text-rose-600 text-xs w-4 text-center"></i>
                            Full Name <span class="text-rose-600">*</span>
                        </label>
                        <input name="fullname" type="text" placeholder="e.g. Aryan Sharma" required
                        value="<%= contact?.fullname || '' %>"
                            class="w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50/50 text-gray-800 placeholder:text-gray-400 text-sm focus:bg-white focus:border-rose-600 focus:ring-2 focus:ring-rose-200 focus:outline-none transition duration-200" />
                    </div>

                    <!-- Email -->
                    <div class="flex flex-col gap-1">
                        <label class="text-sm font-semibold text-gray-800 flex items-center gap-2">
                            <i class="fas fa-envelope text-rose-600 text-xs w-4 text-center"></i>
                            Email Address <span class="text-rose-600">*</span>
                        </label>
                        <input name="email" type="email" placeholder="you@example.com" required
                        value="<%= contact?.email || '' %>"
                            class="w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50/50 text-gray-800 placeholder:text-gray-400 text-sm focus:bg-white focus:border-rose-600 focus:ring-2 focus:ring-rose-200 focus:outline-none transition duration-200" />
                    </div>

                    <!-- Mobile (optional) -->
                    <div class="flex flex-col gap-1">
                        <label class="text-sm font-semibold text-gray-800 flex items-center gap-2">
                            <i class="fas fa-phone text-rose-600 text-xs w-4 text-center"></i>
                            Mobile Number <span class="text-gray-400 text-xs font-normal ml-1">(optional)</span>
                        </label>
                        <input name="mobilenumber" type="tel" placeholder="+91 98765 43210"
                        value="<%= contact?.mobilenumber || '' %>"
                            class="w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50/50 text-gray-800 placeholder:text-gray-400 text-sm focus:bg-white focus:border-rose-600 focus:ring-2 focus:ring-rose-200 focus:outline-none transition duration-200" />
                    </div>

                    <!-- Subject -->
                    <div class="flex flex-col gap-1">
                        <label class="text-sm font-semibold text-gray-800 flex items-center gap-2">
                            <i class="fas fa-tag text-rose-600 text-xs w-4 text-center"></i>
                            Subject <span class="text-rose-600">*</span>
                        </label>
                        <input name="subject" type="text" placeholder="e.g. Blood Donation Query" required
                        value="<%= contact?.subject || '' %>"
                            class="w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50/50 text-gray-800 placeholder:text-gray-400 text-sm focus:bg-white focus:border-rose-600 focus:ring-2 focus:ring-rose-200 focus:outline-none transition duration-200" />
                    </div>

                    <!-- Message (full width) -->
                    <div class="flex flex-col gap-1 md:col-span-2">
                        <label class="text-sm font-semibold text-gray-800 flex items-center gap-2">
                            <i class="fas fa-message text-rose-600 text-xs w-4 text-center"></i>
                            Message <span class="text-rose-600">*</span>
                        </label>
                        <textarea name="message" rows="4" placeholder="Describe your query or feedback..." required
                        
                            class="w-full px-4 py-3 border border-gray-200 rounded-xl bg-gray-50/50 text-gray-800 placeholder:text-gray-400 text-sm resize-y min-h-[120px] focus:bg-white focus:border-rose-600 focus:ring-2 focus:ring-rose-200 focus:outline-none transition duration-200"
                            <%= contact?.message || '' %>></textarea>
                    </div>

                    <!-- Submit button -->
                    <div class="md:col-span-2 flex justify-end mt-2">
                        <button type="submit"
                            class="inline-flex items-center gap-3 px-8 py-3.5 bg-rose-600 hover:bg-rose-700 active:scale-[0.98] text-white font-semibold rounded-full shadow-md shadow-rose-600/25 hover:shadow-rose-600/35 transition-all duration-200 text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-rose-300 focus:ring-offset-2">
                            <i class="fas fa-paper-plane text-sm"></i>
                            Send Message
                        </button>
                    </div>
                </form>

                <!-- Contact Info Section (below form) -->
                <div
                    class="mt-10 pt-6 border-t border-gray-100/80 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">

                    <!-- Email -->
                    <div class="flex items-start gap-3">
                        <div
                            class="w-9 h-9 rounded-full bg-rose-100 flex items-center justify-center text-rose-600 text-sm flex-shrink-0">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <div>
                            <p class="text-[0.6rem] uppercase tracking-wider text-gray-400 font-semibold">Email</p>
                            <p class="text-sm font-medium text-gray-800"><a href="mailto:support@lifelink.com"
                                    class="hover:text-rose-600 transition">support@lifelink.com</a></p>
                        </div>
                    </div>

                    <!-- Phone -->
                    <div class="flex items-start gap-3">
                        <div
                            class="w-9 h-9 rounded-full bg-rose-100 flex items-center justify-center text-rose-600 text-sm flex-shrink-0">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div>
                            <p class="text-[0.6rem] uppercase tracking-wider text-gray-400 font-semibold">Phone</p>
                            <p class="text-sm font-medium text-gray-800"><a href="tel:+919876543210"
                                    class="hover:text-rose-600 transition">+91 98765 43210</a></p>
                        </div>
                    </div>

                    <!-- Address -->
                    <div class="flex items-start gap-3">
                        <div
                            class="w-9 h-9 rounded-full bg-rose-100 flex items-center justify-center text-rose-600 text-sm flex-shrink-0">
                            <i class="fas fa-location-dot"></i>
                        </div>
                        <div>
                            <p class="text-[0.6rem] uppercase tracking-wider text-gray-400 font-semibold">Address</p>
                            <p class="text-sm font-medium text-gray-800">Bhopal, MP, India</p>
                        </div>
                    </div>

                    <!-- Availability -->
                    <div class="flex items-start gap-3">
                        <div
                            class="w-9 h-9 rounded-full bg-rose-100 flex items-center justify-center text-rose-600 text-sm flex-shrink-0">
                            <i class="far fa-clock"></i>
                        </div>
                        <div>
                            <p class="text-[0.6rem] uppercase tracking-wider text-gray-400 font-semibold">Availability
                            </p>
                            <p class="text-sm font-medium text-gray-800">Mon–Sat · 9 AM – 6 PM</p>
                        </div>
                    </div>
                </div>

                <!-- small footer note (optional, but clean) -->
                <p class="text-center text-[0.6rem] text-gray-400 mt-6 tracking-wide">
                    <i class="fas fa-heart text-rose-400 text-[0.5rem] mr-1"></i>
                    We reply within 24 hours
                </p>
            </div>

        </div>

        <%- include("../partials/footer") %>