<%- include("../partials/head") %>
    <%- include("../partials/navbar") %>


        <!-- ========== HERO SECTION ========== -->
        <section class="pt-24 pb-16 md:pt-32 md:pb-24"
            style="background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                <div class="inline-block bg-red-500/20 text-red-300 px-4 py-1 rounded-full text-sm font-semibold mb-4">
                    <i class="fas fa-heartbeat mr-2"></i> Every 2 seconds, someone needs blood
                </div>
                <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">
                    Donate Blood, <br class="sm:hidden" />
                    <span class="text-red-400">Save Lives</span>
                </h1>
                <p class="text-gray-300 text-lg md:text-xl max-w-2xl mx-auto mb-8">
                    "Ek pint blood teen jaan bacha sakta hai" — Join thousands of heroes who donate daily.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a href="/register"
                        class="bg-red-600 text-white px-8 py-4 rounded-full font-bold text-lg hover:bg-red-700 transition shadow-lg shadow-red-600/30">
                        <i class="fas fa-heart mr-2"></i> Register as Donor
                    </a>
                    <a href="/donors"
                        class="bg-white/10 backdrop-blur-sm text-white border border-white/30 px-8 py-4 rounded-full font-bold text-lg hover:bg-white/20 transition">
                        <i class="fas fa-map-marker-alt mr-2"></i> Find Donors
                    </a>
                </div>
            </div>
        </section>

        <!-- ========== LIVE STATS ========== -->
        <section class="py-12 bg-gray-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <div
                        class="bg-white rounded-2xl shadow-md p-6 text-center hover:transform hover:-translate-y-1 transition-all hover:shadow-lg">
                        <div class="text-4xl text-red-500 mb-2"><i class="fas fa-users"></i></div>
                        <div class="text-3xl font-bold text-gray-800">
                            <%= totalDonors %>
                        </div>
                        <p class="text-gray-500">Donors Registered</p>
                    </div>
                    <div
                        class="bg-white rounded-2xl shadow-md p-6 text-center hover:transform hover:-translate-y-1 transition-all hover:shadow-lg">
                        <div class="text-4xl text-red-500 mb-2"><i class="fas fa-heart"></i></div>
                        <div class="text-3xl font-bold text-gray-800">
                            <%= totalBloodRequest %>
                        </div>
                        <p class="text-gray-500">Total Blood Requests </p>
                    </div>
                    <div
                        class="bg-white rounded-2xl shadow-md p-6 text-center hover:transform hover:-translate-y-1 transition-all hover:shadow-lg">
                        <div class="text-4xl text-red-500 mb-2"><i class="fas fa-tint"></i></div>
                        <div class="text-3xl font-bold text-gray-800">
                            <%= availableDonors %>
                        </div>
                        <p class="text-gray-500">Available Donors</p>
                    </div>
                    <div
                        class="bg-white rounded-2xl shadow-md p-6 text-center hover:transform hover:-translate-y-1 transition-all hover:shadow-lg">
                        <div class="text-4xl text-red-500 mb-2"><i class="fas fa-clock"></i></div>
                        <div class="text-3xl font-bold text-gray-800">
                            <%= urgentRequest %>
                        </div>
                        <p class="text-gray-500">Urgent Requests</p>
                    </div>
                </div>


                <!-- ========== HOW IT WORKS ========== -->
                <section class="py-16 bg-white">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                        <h2 class="text-3xl font-bold text-center text-gray-800 mb-4">How It Works</h2>
                        <p class="text-center text-gray-500 mb-12">3 simple steps to become a hero</p>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                            <div
                                class="text-center p-6 rounded-2xl bg-gray-50 hover:transform hover:-translate-y-1 transition-all hover:shadow-lg">
                                <div
                                    class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl text-red-600">
                                    <i class="fas fa-clipboard-list"></i>
                                </div>
                                <h3 class="text-xl font-bold text-gray-800">1. Register</h3>
                                <p class="text-gray-500 mt-2">Fill basic details in just 2 minutes</p>
                            </div>
                            <div
                                class="text-center p-6 rounded-2xl bg-gray-50 hover:transform hover:-translate-y-1 transition-all hover:shadow-lg">
                                <div
                                    class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl text-red-600">
                                    <i class="fas fa-location-dot"></i>
                                </div>
                                <h3 class="text-xl font-bold text-gray-800">2. Become a Donor</h3>
                                <p class="text-gray-500 mt-2">Complete your donor profile and update your availability
                                </p>
                            </div>
                            <div
                                class="text-center p-6 rounded-2xl bg-gray-50 hover:transform hover:-translate-y-1 transition-all hover:shadow-lg">
                                <div
                                    class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl text-red-600">
                                    <i class="fas fa-droplet"></i>
                                </div>
                                <h3 class="text-xl font-bold text-gray-800">3. Help Save Lives</h3>
                                <p class="text-gray-500 mt-2">Save a life with your precious gift</p>
                            </div>
                        </div>
                    </div>
                </section>



                <!-- ========== SUCCESS STORY ========== -->
                <section class="py-16 bg-red-600 text-white">
                    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
                        <div class="text-6xl mb-4"><i class="fas fa-award"></i></div>
                        <blockquote class="text-2xl md:text-3xl font-medium italic">
                            "Meri donation se ek bacchi ki jaan bachi. Maine kuch nahi khoya, lekin ek pari ki jaan
                            bacha li."
                        </blockquote>
                        <p class="mt-4 text-red-200 font-semibold">— Rahul Sharma, Donor since 2023</p>
                        <p class="mt-4 text-red-200 font-semibold">"Your one donation can save up to three lives"</p>

                    </div>
                </section>

                <!-- ========== QUICK ACTION BUTTONS ========== -->
                <section class="py-12 bg-gray-100">
                    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <a href="/become-donor"
                                class="bg-white text-gray-800 px-6 py-4 rounded-xl font-semibold shadow-md hover:shadow-lg hover:bg-red-50 transition flex items-center justify-center gap-3">
                                <span class="text-2xl"><i class="fas fa-clipboard-list text-red-500"></i></span>Become a
                                Donor
                            </a>
                            <a href="/donors"
                                class="bg-white text-gray-800 px-6 py-4 rounded-xl font-semibold shadow-md hover:shadow-lg hover:bg-red-50 transition flex items-center justify-center gap-3">
                                <span class="text-2xl"><i class="fas fa-users text-blue-500"></i></span> View Donors
                            </a>
                            <a href="/requests/create"
                                class="bg-white text-gray-800 px-6 py-4 rounded-xl font-semibold shadow-md hover:shadow-lg hover:bg-red-50 transition flex items-center justify-center gap-3">
                                <span class="text-2xl"><i class="fas fa-hand-holding-droplet text-red-500"></i></span>
                                Request Blood
                            </a>
                        </div>
                    </div>
                </section>
                <%- include("../partials/footer") %>