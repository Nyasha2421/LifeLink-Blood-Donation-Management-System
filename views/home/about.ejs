<%- include("../partials/head") %>
  <%- include("../partials/navbar") %>

    <div class="bg-white text-gray-800 font-sans antialiased">

      <!-- main about page – 5 sections, no header/nav/footer -->
      <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-16">

        <!-- 1. Hero Section -->
        <section
          class="text-center space-y-4 py-8 bg-gradient-to-b from-teal-50 via-white to-transparent rounded-3xl px-4 border-b-2 border-teal-500">
          <h1 class="text-5xl md:text-6xl font-extrabold text-slate-800 tracking-tight drop-shadow-sm">About LifeLink
          </h1>
          <span
            class="inline-block px-4 py-1 bg-teal-100 text-teal-800 text-sm font-semibold rounded-full mb-2">Together We
            Can Save Lives</span>
          <p class="text-xl md:text-2xl text-gray-600 max-w-2xl mx-auto leading-relaxed font-light">
            LifeLink is a blood donation management platform that connects blood donors with people in need.
            Our mission is to make blood donation simple, fast, and accessible while helping save lives through
            community support.
          </p>
        </section>

        <!-- 2. Our Mission – 3 cards -->
        <section>
          <div class="flex items-center justify-center gap-3 mb-8">
            <div class="h-1 w-12 bg-teal-500 rounded"></div>
            <h2 class="text-3xl font-bold text-slate-800 tracking-wide">Our Mission</h2>
            <div class="h-1 w-12 bg-teal-500 rounded"></div>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- card 1 -->
            <div
              class="bg-gradient-to-br from-white to-teal-50 rounded-2xl p-6 shadow-lg hover:shadow-2xl transition-all duration-300 text-center border-l-2 border-teal-500 hover:-translate-y-1">
              <div class="text-3xl mb-3 inline-block bg-red-100 p-4 rounded-full text-red-600"><i
                  class="fas fa-heart"></i></div>
              <h3 class="text-xl font-bold text-slate-800 mb-2">Save Lives</h3>
              <p class="text-gray-600 leading-relaxed">Encourage voluntary blood donation and help patients receive
                blood on time.</p>
            </div>
            <!-- card 2 -->
            <div
              class="bg-gradient-to-br from-white to-teal-50 rounded-2xl p-6 shadow-lg hover:shadow-2xl transition-all duration-300 text-center border-l-2 border-teal-500 hover:-translate-y-1">
              <div class="text-3xl mb-3 inline-block bg-yellow-100 p-4 rounded-full text-yellow-500"><i
                  class="fas fa-handshake"></i></div>
              <h3 class="text-xl font-bold text-slate-800 mb-2">Connect People</h3>
              <p class="text-gray-600 leading-relaxed">Connect donors and recipients through a simple and secure
                platform.</p>
            </div>
            <!-- card 3 -->
            <div
              class="bg-gradient-to-br from-white to-teal-50 rounded-2xl p-6 shadow-lg hover:shadow-2xl transition-all duration-300 text-center border-l-2 border-teal-500 hover:-translate-y-1">
              <div class="text-3xl mb-3 inline-block bg-blue-100 p-4 rounded-full text-blue-600"><i
                  class="fas fa-bolt"></i></div>
              <h3 class="text-xl font-bold text-slate-800 mb-2">Quick Access</h3>
              <p class="text-gray-600 leading-relaxed">Make it easier to find blood donors during emergencies.</p>
            </div>
          </div>
        </section>

        <!-- 3. Why Choose LifeLink? – 4 feature cards -->
        <section>
          <div class="flex items-center justify-center gap-3 mb-8">
            <div class="h-1 w-12 bg-teal-500 rounded"></div>
            <h2 class="text-3xl font-bold text-slate-800 tracking-wide">Why Choose LifeLink?</h2>
            <div class="h-1 w-12 bg-teal-500 rounded"></div>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- card 1 -->
            <div
              class="bg-white rounded-2xl p-6 shadow-lg border-b-2 border-teal-500 hover:border-slate-700 hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
              <div class="text-4xl mb-3 bg-red-50 w-14 h-14 rounded-xl flex items-center justify-center text-red-600"><i
                  class="fas fa-tint"></i></div>
              <h3 class="text-lg font-bold text-slate-800 mb-1">Easy Donor Registration</h3>
              <p class="text-sm text-gray-600 leading-relaxed">Quick sign-up, minimal steps, start saving lives
                instantly.</p>
            </div>
            <!-- card 2 -->
            <div
              class="bg-white rounded-2xl p-6 shadow-lg border-b-2 border-teal-500 hover:border-slate-700 hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
              <div class="text-4xl mb-3 bg-blue-50 w-14 h-14 rounded-xl flex items-center justify-center text-blue-600">
                <i class="fas fa-search"></i></div>
              <h3 class="text-lg font-bold text-slate-800 mb-1">Quick Donor Search</h3>
              <p class="text-sm text-gray-600 leading-relaxed">Find the right blood type nearby in seconds.</p>
            </div>
            <!-- card 3 -->
            <div
              class="bg-white rounded-2xl p-6 shadow-lg border-b-2 border-teal-500 hover:border-slate-700 hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
              <div
                class="text-4xl mb-3 bg-slate-50 w-14 h-14 rounded-xl flex items-center justify-center text-slate-600">
                <i class="fas fa-user"></i></div>
              <h3 class="text-lg font-bold text-slate-800 mb-1">View Donor Profiles</h3>
              <p class="text-sm text-gray-600 leading-relaxed">See availability, blood type, and contact details.</p>
            </div>
            <!-- card 4 -->
            <div
              class="bg-white rounded-2xl p-6 shadow-lg border-b-2 border-teal-500 hover:border-slate-700 hover:shadow-2xl transition-all duration-300 hover:-translate-y-1">
              <div
                class="text-4xl mb-3 bg-orange-50 w-14 h-14 rounded-xl flex items-center justify-center text-orange-600">
                <i class="fas fa-lock"></i></div>
              <h3 class="text-lg font-bold text-slate-800 mb-1">Secure &amp; Simple Platform</h3>
              <p class="text-sm text-gray-600 leading-relaxed">Your data is safe, and the interface is intuitive.</p>
            </div>
          </div>
        </section>

        <!-- 4. Our Features – actual features list -->
        <section>
          <div class="flex items-center justify-center gap-3 mb-6">
            <div class="h-1 w-12 bg-teal-500 rounded"></div>
            <h2 class="text-3xl font-bold text-slate-800 tracking-wide">Our Features</h2>
            <div class="h-1 w-12 bg-teal-500 rounded"></div>
          </div>
          <div
            class="bg-gradient-to-br from-teal-50 to-white rounded-2xl p-6 md:p-8 shadow-xl border-2 border-teal-200 max-w-3xl mx-auto">
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-gray-800">
              <li
                class="flex items-center gap-3 bg-white rounded-xl px-4 py-3 shadow-md border-l-4 border-teal-500 hover:border-slate-700 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
                <span class="text-teal-600 text-xl font-bold">✓</span> <span class="font-medium">Donor
                  Registration</span>
              </li>
              <li
                class="flex items-center gap-3 bg-white rounded-xl px-4 py-3 shadow-md border-l-4 border-teal-500 hover:border-slate-700 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
                <span class="text-teal-600 text-xl font-bold">✓</span> <span class="font-medium">View Donor List</span>
              </li>
              <li
                class="flex items-center gap-3 bg-white rounded-xl px-4 py-3 shadow-md border-l-4 border-teal-500 hover:border-slate-700 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
                <span class="text-teal-600 text-xl font-bold">✓</span> <span class="font-medium">View Donor
                  Details</span>
              </li>
              <li
                class="flex items-center gap-3 bg-white rounded-xl px-4 py-3 shadow-md border-l-4 border-teal-500 hover:border-slate-700 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
                <span class="text-teal-600 text-xl font-bold">✓</span> <span class="font-medium">Edit Donor
                  Information</span>
              </li>
              <li
                class="flex items-center gap-3 bg-white rounded-xl px-4 py-3 shadow-md border-l-4 border-teal-500 hover:border-slate-700 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
                <span class="text-teal-600 text-xl font-bold">✓</span> <span class="font-medium">Delete Donor
                  Record</span>
              </li>
              <li
                class="flex items-center gap-3 bg-white rounded-xl px-4 py-3 shadow-md border-l-4 border-teal-500 hover:border-slate-700 hover:shadow-lg transition-all duration-300 hover:-translate-y-0.5">
                <span class="text-teal-600 text-xl font-bold">✓</span> <span class="font-medium">Blood Request</span>
              </li>
            </ul>
          </div>
        </section>

        <!-- 5. Call to Action – navy blue + teal gradient -->
        <section
          class="bg-gradient-to-br from-slate-800 via-slate-800 to-teal-700 rounded-2xl py-14 px-6 text-center text-white shadow-2xl hover:shadow-slate-800/40 transition-all duration-300 relative overflow-hidden">
          <div
            class="absolute inset-0 opacity-10 bg-[radial-gradient(circle_at_20%_50%,_white_1px,transparent_1px)] bg-[length:20px_20px] pointer-events-none">
          </div>
          <div class="relative z-10">
            <h2 class="text-4xl md:text-5xl font-extrabold mb-4 drop-shadow-lg">Become a Hero Today <i
                class="fas fa-heart text-red-500"></i></h2>
            <p class="text-xl md:text-2xl max-w-2xl mx-auto leading-relaxed text-teal-100 font-light">
              Your single blood donation can save multiple lives. Join LifeLink and become a part of a life-saving
              community.
            </p>
            <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center items-center">
              <a href="/register"
                class="inline-block bg-transparent text-white font-semibold px-8 py-4 rounded-full border-2 border-white/50 hover:border-white hover:bg-white/10 transition-all duration-300 text-lg">
                Register as Donor
              </a>
            </div>
          </div>

        </section>

      </main>
    </div>

    <%- include("../partials/footer") %>