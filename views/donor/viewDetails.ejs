<%- include("../partials/head") %>
   <%- include("../partials/navbar") %>

      <div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-16 px-4">
         <div class="max-w-2xl mx-auto">

            <!-- Main Profile Card -->
            <div
               class="bg-white rounded-3xl shadow-2xl border border-gray-200 p-10 transition-all duration-300 hover:shadow-3xl">

               <!-- Header -->
               <div class="flex items-center gap-3 mb-8 pb-5 border-b-2 border-gray-100">
                  <div class="w-1 h-10 bg-gradient-to-b from-blue-500 to-indigo-600 rounded-full"></div>
                  <h2 class="text-2xl font-bold text-gray-800 tracking-tight">
                     <%= donor.fullname %> Profile Details
                  </h2>
               </div>

               <!-- Donor Info Grid -->
               <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                  <div class="bg-gray-50 rounded-xl p-4 hover:bg-gray-100 transition">
                     <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Full Name</span>
                     <p class="text-lg font-semibold text-gray-800 mt-1">
                        <%= donor.fullname %>
                     </p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-4 hover:bg-gray-100 transition">
                     <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Age</span>
                     <p class="text-lg font-semibold text-gray-800 mt-1">
                        <%= donor.age %>
                     </p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-4 hover:bg-gray-100 transition">
                     <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Gender</span>
                     <p class="text-lg font-semibold text-gray-800 mt-1">
                        <%= donor.gender %>
                     </p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-4 hover:bg-gray-100 transition">
                     <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Blood Group</span>
                     <p class="text-lg font-semibold text-red-600 mt-1">
                        <%= donor.bloodgroup %>
                     </p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-4 hover:bg-gray-100 transition">
                     <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Mobile</span>
                     <p class="text-lg font-semibold text-gray-800 mt-1">
                        <%= donor.mobilenumber %>
                     </p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-4 hover:bg-gray-100 transition">
                     <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">City</span>
                     <p class="text-lg font-semibold text-gray-800 mt-1">
                        <%= donor.city %>
                     </p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-4 hover:bg-gray-100 transition md:col-span-2">
                     <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Address</span>
                     <p class="text-lg font-semibold text-gray-800 mt-1">
                        <%= donor.address %>
                     </p>
                  </div>
                  <div class="bg-gray-50 rounded-xl p-4 hover:bg-gray-100 transition md:col-span-2">
                     <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Availabilty</span>
                     <p class="text-lg font-semibold text-gray-800 mt-1">
                        <% if(donor.available==true){ %>
                           <span class="text-[10px] text-slate-400 uppercase tracking-widest flex items-center gap-1.5">
                              <span class="relative flex h-2 w-2">
                                 <span
                                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                 <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                              </span>
                              Available
                           </span>
                           <% } else { %>
                              <span
                                 class="text-[10px] text-slate-400 uppercase tracking-widest flex items-center gap-1.5">
                                 <span class="relative flex h-2 w-2">
                                    <span
                                       class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                                    <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                                 </span>
                                 Not Available
                              </span>
                              <% } %>

                     </p>
                  </div>
               </div>

               <!-- Action Buttons -->
               <% if(isOwner) { %>
                  <div class="flex flex-wrap gap-4 pt-4 border-t-2 border-gray-100">
                     <a href="/donors/edit/<%= donor._id %>"
                        class="flex-1 min-w-[120px] text-center px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-[1.02]">
                        Edit
                     </a>
                     <a href="/donors/delete/<%= donor._id %>"
                        class="flex-1 min-w-[120px] text-center px-6 py-3 bg-gradient-to-r from-red-500 to-red-600 hover:from-red-600 hover:to-red-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-[1.02]">
                        Delete
                     </a>
                  </div>
                  <% } %>
            </div>
         </div>
      </div>

      <%- include("../partials/footer") %>