<%- include("../partials/head") %>
  <%- include("../partials/navbar") %>

    <div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-50 py-16 px-4">

      <div class="max-w-3xl mx-auto">

        <!-- Edit Form Card -->
        <div
          class="bg-white rounded-3xl shadow-2xl border border-gray-200 p-8 md:p-10 transition-all duration-300 hover:shadow-3xl">

          <!-- Form Header -->
          <div class="flex items-center gap-3 mb-8 pb-5 border-b-2 border-gray-100">
            <div class="w-1 h-10 bg-gradient-to-b from-blue-500 to-indigo-600 rounded-full"></div>
            <h2 class="text-2xl font-bold text-gray-800 tracking-tight">Edit Donor Details</h2>
          </div>

          <% if(errorMessage) {%>
            <div class="bg-red-100 text-red-700 p-3 rounded-lg mb-4">
              <%= errorMessage %>
            </div>
            <% } %>

              <!-- Edit Form -->
              <form action="/donors/edit/<%= donor._id %>" method="POST" class="space-y-5">
                <!-- Full Name -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">Full Name</label>
                  <input type="text" name="fullname" value="<%= donor.fullname %>"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200 text-gray-800">
                </div>

                <!-- Age -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">Age</label>
                  <input type="number" name="age" value="<%= donor.age %>"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200 text-gray-800">
                </div>

                <!-- Gender -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">Gender</label>
                  <select name="gender"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200 text-gray-800">
                    <option value="<%= donor.gender %>" selected>
                      <%= donor.gender %>
                    </option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                  </select>
                </div>

                <!-- Blood Group -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">Blood Group</label>
                  <select name="bloodgroup"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200 text-gray-800">
                    <option value="<%= donor.bloodgroup %>" selected>
                      <%= donor.bloodgroup %>
                    </option>
                    <option value="A+">A+</option>
                    <option value="A-">A-</option>
                    <option value="B+">B+</option>
                    <option value="B-">B-</option>
                    <option value="AB+">AB+</option>
                    <option value="AB-">AB-</option>
                    <option value="O+">O+</option>
                    <option value="O-">O-</option>
                  </select>
                </div>

                <!-- Mobile Number -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">Mobile Number</label>
                  <input name="mobilenumber" type="tel" value="<%= donor.mobilenumber %>"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200 text-gray-800">
                </div>

                <!-- City -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">City</label>
                  <input name="city" type="text" value="<%= donor.city %>"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200 text-gray-800">
                </div>

                <!-- Address -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">Address</label>
                  <textarea name="address" rows="3"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200 text-gray-800 resize-none"><%= donor.address %></textarea>
                </div>

                <!-- Availability -->
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-2">Availability</label>
                  <select name="available"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition duration-200 text-gray-800">
                    <option value="true" <%=donor.available ? "selected" : "" %>>Available</option>
                    <option value="false" <%=! donor.available ? "selected" : "" %>>Not Available</option>
                  </select>
                </div>

                <!-- Form Actions -->
                <div class="flex flex-wrap gap-4 pt-4 mt-6 border-t-2 border-gray-100">
                  <button type="submit"
                    class="flex-1 min-w-[120px] px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-[1.02]">
                    Save Changes
                  </button>
                  <a href="#"
                    class="flex-1 min-w-[120px] text-center px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold rounded-xl shadow-lg hover:shadow-xl transition-all duration-200 transform hover:scale-[1.02]">
                    Cancel
                  </a>
                </div>
              </form>
        </div>
      </div>
    </div>

    <%- include("../partials/footer") %>