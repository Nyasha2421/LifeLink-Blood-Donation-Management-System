<%- include("../partials/head") %>
  <%- include("../partials/navbar") %>
    <!-- Main Content - adjusted spacing: mt-16 for navbar, mb-8 for footer -->

    <% if(donors.length> 0){ %>
      <div class="min-h-screen flex flex-col bg-gradient-to-br from-slate-50 via-white to-rose-50/30">

        <!-- Main Content -->
        <main class="flex-grow mt-16 mb-8 px-4">

          <!-- Stylish Heading with gradient -->
          <div class="text-center mb-10">
            <div class="relative inline-block">
              <h1
                class="text-4xl md:text-5xl font-bold mt-2 tracking-tight bg-gradient-to-r from-rose-600 to-rose-400 bg-clip-text text-transparent">
                LifeSavers
              </h1>
              <div class="absolute -top-2 -right-8 text-2xl opacity-20">🩸</div>
            </div>
            <p class="text-slate-500 mt-2 text-sm md:text-base font-light tracking-wide">
              Every drop counts • <span class="text-rose-500 font-semibold">
                <%= donors.length %>
              </span> heroes ready
            </p>
            <div class="flex justify-center gap-1 mt-3">
              <span class="w-8 h-1 rounded-full bg-rose-300"></span>
              <span class="w-12 h-1 rounded-full bg-rose-500"></span>
              <span class="w-8 h-1 rounded-full bg-rose-300"></span>
            </div>
          </div>

          <!-- Donor Cards Grid - Unique glassmorphism + gradient borders -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 max-w-7xl mx-auto">
            <% donors.forEach(donor=> { %>
              <div
                class="card group relative bg-white/70 backdrop-blur-sm rounded-2xl p-5 transition-all duration-300 hover:scale-[1.02] hover:bg-white/90 border border-white/50 shadow-lg hover:shadow-2xl">

                <!-- Animated gradient border -->
                <div
                  class="absolute inset-0 rounded-2xl bg-gradient-to-r from-rose-400 via-pink-300 to-rose-400 opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10 blur-sm">
                </div>
                <div class="absolute inset-0 rounded-2xl bg-white/70 backdrop-blur-sm -z-5"></div>

                <!-- Card Content -->
                <div class="relative z-10">
                  <!-- Name with icon & blood type -->
                  <div class="flex items-start justify-between mb-3">
                    <div>
                      <h2 class="text-xl font-bold text-slate-800 group-hover:text-rose-700 transition-colors">
                        <%= donor.fullname %>
                      </h2>
                      <div class="flex items-center gap-2 mt-1">
                        <span
                          class="inline-flex items-center gap-1 px-3 py-0.5 rounded-full text-xs font-bold bg-gradient-to-r from-rose-100 to-rose-200 text-rose-700 border border-rose-300/50">
                          <span class="text-base">🩸</span>
                          <%= donor.bloodgroup %>
                        </span>
                        <span
                          class="text-xs text-slate-400 bg-slate-100/80 px-2.5 py-0.5 rounded-full capitalize backdrop-blur-sm">
                          <%= donor.gender %>
                        </span>
                      </div>
                    </div>
                    <div
                      class="w-10 h-10 rounded-full bg-gradient-to-br from-rose-100 to-pink-100 flex items-center justify-center text-rose-500 text-lg shadow-inner border border-rose-200/50">
                      👤
                    </div>
                  </div>

                  <!-- Divider with dot -->
                  <div class="flex items-center gap-2 my-3">
                    <div class="flex-1 h-px bg-gradient-to-r from-transparent via-rose-300 to-transparent"></div>
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                    <div class="flex-1 h-px bg-gradient-to-r from-transparent via-rose-300 to-transparent"></div>
                  </div>

                  <!-- Location details with icons -->
                  <div class="space-y-2 text-sm">
                    <div class="flex items-center gap-2.5 text-slate-600 bg-slate-50/50 px-3 py-1.5 rounded-lg">
                      <svg class="w-4 h-4 text-rose-400 flex-shrink-0" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      <span class="font-medium">
                        <%= donor.city %>
                      </span>
                    </div>

                    <div class="flex items-start gap-2.5 text-slate-500 text-xs bg-slate-50/50 px-3 py-1.5 rounded-lg">
                      <svg class="w-4 h-4 text-rose-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-4 0a1 1 0 01-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 01-1 1h-2z" />
                      </svg>
                      <span class="break-words leading-relaxed">
                        <%= donor.address %>
                      </span>
                    </div>
                    <div>
                      <a href="/donors/<%= donor._id %>"
                        class="inline-block px-4 py-2 bg-red-600 hover:bg-red-700 text-white text-sm font-medium rounded-lg shadow transition">
                        View Details
                      </a>
                    </div>
                  </div>

                  <!-- Status badge with pulse -->
                  <% if(donor.available===true){ %>
                    <div class="mt-3 pt-2 border-t border-rose-100/50 flex justify-between items-center">
                      <span class="text-[10px] text-slate-400 uppercase tracking-widest flex items-center gap-1.5">
                        <span class="relative flex h-2 w-2">
                          <span
                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                        </span>
                        Available
                      </span>
                      <span class="text-[10px] text-rose-300 font-medium tracking-wider">❤️ donor</span>
                    </div>
                    <% } else { %>
                      <div class="mt-3 pt-2 border-t border-rose-100/50 flex justify-between items-center">
                        <span class="text-[10px] text-slate-400 uppercase tracking-widest flex items-center gap-1.5">
                          <span class="relative flex h-2 w-2">
                            <span
                              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
                          </span>
                          Not Available
                        </span>
                        <span class="text-[10px] text-rose-300 font-medium tracking-wider">❤️ donor</span>
                      </div>

                      <% } %>

                </div>
              </div>
              <% }) %>
          </div>

          <!-- Decorative bottom element -->
          <div class="flex justify-center mt-10">
            <div class="flex items-center gap-2 text-xs text-slate-400">
              <span class="w-16 h-px bg-gradient-to-r from-transparent to-rose-300"></span>
              <span class="text-rose-300 text-lg">✦</span>
              <span class="w-16 h-px bg-gradient-to-l from-transparent to-rose-300"></span>
            </div>
          </div>

        </main>
      </div>


      <% } else { %>
        <div class="max-w-4xl mx-auto p-4">

          <div class="bg-white rounded-2xl shadow-md p-8 md:p-12 text-center border border-rose-100">

            <!-- Icon -->
            <div class="w-20 h-20 mx-auto mb-5 rounded-full bg-rose-100 flex items-center justify-center">
              <i class="fa-solid fa-heart text-4xl text-rose-600"></i>
            </div>

            <!-- Heading -->
            <h2 class="text-2xl md:text-3xl font-bold text-gray-800">
              No Blood Donors Found
            </h2>

            <!-- Message -->
            <p class="text-gray-600 mt-3 max-w-lg mx-auto leading-relaxed">
              We couldn't find any registered blood donors at the moment.
              Register yourself as a donor and make a difference in someone's life.
            </p>

            <!-- Button -->
            <a href="/become-donor"
              class="inline-flex items-center gap-2 mt-6 bg-rose-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-rose-700 transition shadow-md hover:shadow-lg">

              <i class="fa-solid fa-droplet"></i>
              Become a Donor
            </a>

          </div>

        </div>


        <% } %>

          <%- include("../partials/footer") %>