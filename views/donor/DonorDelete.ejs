<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Donor Delete❤️</title>
  <!-- Tailwind via CDN (simple + stylish) -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome for subtle icons (optional but adds style) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
</head>

<body class="min-h-screen flex items-center justify-center bg-gradient-to-br from-rose-50 to-pink-100 p-4">

  <div
    class="w-full max-w-md bg-white/80 backdrop-blur-sm rounded-3xl shadow-xl shadow-rose-200/50 p-8 text-center border border-white/50 transition-all duration-300 hover:shadow-rose-300/30">

    <!-- Icon / Emoji -->
    <div class="flex justify-center mb-4">
      <span class="text-6xl drop-shadow-md">❤️</span>
    </div>

    <!-- Main Heading -->
    <h1 class="text-3xl font-bold text-rose-700 tracking-tight">
      Donor Delete <span class="text-rose-500">Successfully</span>
    </h1>

    <!-- Divider with heart -->
    <div class="flex items-center justify-center gap-2 my-3">
      <div class="h-[2px] w-12 bg-rose-200 rounded-full"></div>
      <i class="fas fa-heart text-rose-400 text-sm"></i>
      <div class="h-[2px] w-12 bg-rose-200 rounded-full"></div>
    </div>

    <!-- [Go to Home button] – exactly as requested -->
    <div class="mt-7">
      <a href="/donors"
        class="group relative inline-flex items-center justify-center w-full sm:w-auto px-8 py-3.5 bg-gradient-to-r from-rose-500 to-rose-600 text-white font-semibold rounded-full shadow-md shadow-rose-200 hover:shadow-lg hover:shadow-rose-300/40 transition-all duration-300 hover:scale-[1.02] active:scale-95 focus:outline-none focus:ring-2 focus:ring-rose-300 focus:ring-offset-2">
        <i class="fas fa-home mr-2 group-hover:translate-x-[-2px] transition-transform"></i>
        Go to Donor Page
        <span
          class="absolute -right-1 -top-1 w-3 h-3 bg-rose-300 rounded-full blur-sm opacity-70 group-hover:opacity-100 transition"></span>
      </a>
    </div>

    <!-- Small footer note – extra style -->
    <p class="mt-6 text-[10px] text-rose-300/70 tracking-wider uppercase">
      <i class="fas fa-droplet mr-1 text-rose-300"></i> every drop counts
    </p>
  </div>

</body>

</html>